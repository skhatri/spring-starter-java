<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <notes>This vulnerability only affects applications using the affected component in a specific way that we don't use</notes>
        <packageUrl regex="true">^pkg:maven/org\.yaml/snakeyaml@.*$</packageUrl>
        <vulnerabilityName>CVE-2022-1471</vulnerabilityName>
    </suppress>
    
    <suppress>
        <notes>Test dependencies don't affect production code</notes>
        <packageUrl regex="true">^pkg:maven/org\.junit\..*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    
    <suppress>
        <notes>We don't use the affected functionality</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-.*$</packageUrl>
        <cpe>cpe:/a:pivotal_software:spring_boot</cpe>
        <cve>CVE-2023-20883</cve>
    </suppress>
</suppressions> 